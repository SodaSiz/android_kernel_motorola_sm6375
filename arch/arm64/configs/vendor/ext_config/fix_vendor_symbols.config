# QMI (rmnet dependency)
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_QCOM_QMI_SERVICE=y

# RMNET
CONFIG_RMNET=y
CONFIG_RMNET_DATA=y
CONFIG_RMNET_CTL=y
CONFIG_RMNET_SHS=y

# Qualcomm Audio DSP / APR
CONFIG_SND_SOC_QDSP6=y
CONFIG_SND_SOC_QCOM=y
CONFIG_SND_SOC_QCOM_APR=y
CONFIG_SND_SOC_QCOM_AFE=y
CONFIG_SND_SOC_QCOM_ADM=y
CONFIG_SND_SOC_QCOM_ROUTING=y
