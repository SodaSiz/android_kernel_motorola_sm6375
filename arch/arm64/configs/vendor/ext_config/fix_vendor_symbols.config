# =========================
# QMI (rmnet dependencies)
# =========================
CONFIG_QCOM_QMI_HELPERS=m
CONFIG_QCOM_QMI_SERVICE=m

# =========================
# RMNET
# =========================
CONFIG_RMNET=m
CONFIG_RMNET_DATA=m
CONFIG_RMNET_CTL=m
CONFIG_RMNET_SHS=m

# =========================
# Qualcomm Audio (DSP / APR)
# =========================
CONFIG_SND_SOC_QCOM=m
CONFIG_SND_SOC_QDSP6=m
CONFIG_SND_SOC_QCOM_APR=m
CONFIG_SND_SOC_QCOM_AFE=m
CONFIG_SND_SOC_QCOM_ADM=m
CONFIG_SND_SOC_QCOM_ROUTING=m
